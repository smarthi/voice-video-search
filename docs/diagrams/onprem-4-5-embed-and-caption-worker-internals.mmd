    E3 --> E5["_update doc_as_upsert: visual_vector + ocr + payload"]
    E4 --> E5
    E5 --> E6["Increment visual_done"]
    E6 --> E7["Commit offset"]
  end
  subgraph CWZ["Caption worker"]
    direction TB
    C1["Poll vvs.segments, group vvs.caption"] --> C2["GET proxy still"]
    C2 --> C3["POST vllm-instruct, English caption"]
    C3 --> C4["_update doc_as_upsert: caption"]
    C3 --> C5["PUT caption sidecar for X-Ray"]
    C4 --> C6["Increment caption_done"]
    C5 --> C6
    C6 --> C7["Commit offset"]
  end
