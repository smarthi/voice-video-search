flowchart TB
  Q["Query text, typed or from the mic"] --> QE["Embed twice: Qwen-VL text and BGE query"]
  QE --> FO["Fan out to every data/id/"]
  FO --> VA["visual.faiss ANN, over-fetch 48"]
  FO --> TA["text.faiss ANN, over-fetch 48"]
  TA --> LEX["Lexical IDF rerank on ANN candidates only"]
  LEX --> MAP["Map text hits onto nearby frames: OCR by frame, ASR by window, scene by interval"]
  VA --> RRF["Per-video RRF, k = 60, for the confidence badge"]
  MAP --> RRF
  VA --> MERGE["Archive merge on absolute ANN scores"]
  MAP --> MERGE
  MERGE --> DIV["Diversify: keep hits at least 6 s apart"]
  DIV --> HYD["Hydrate path, t_s, quote, title from SQLite"]
  HYD --> CUT["Cut H.264 clips for the top 3"]
  CUT --> UIR["Cards, gallery, match-density timeline"]
